{
  "expo": {
    "name": "Atalasys-Hide_Phantom",
    "slug": "Atalasys-Hide_Phantom",
    "scheme": "atalasyshidephantom",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#DDDDDD"
      },
      "package": "com.Atalasys_Hide_Phantom.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_MOCK_LOCATION"
      ]
    },
    "plugins": [
      ["./plugins/expo-mock-location/app.plugin.js", {}],
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Phantom GPS benoetigt deinen Standort, um ihn auf der Karte anzuzeigen."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.atalasyshidephantom.app"
    }
  }
}
