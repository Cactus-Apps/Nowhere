{
  "expo": {
    "name": "Nowhere",
    "slug": "nowhere",
    "scheme": "nowhere",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icons/Nowhere_logo_half.png",
    "userInterfaceStyle": "dark",
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-icon-foreground.png",
        "backgroundColor": "#333333",
        "monochromeImage": "./assets/icons/android-icon-foreground.png"
      },
      "package": "com.cactus_apps.nowhere",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_MOCK_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      ["./plugins/expo-mock-location/app.plugin.js", {}],
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nowhere requires your location to display it on the map.",
          "locationAlwaysAndWhenInUsePermission": "Nowhere also requires your location in the background to continue location simulation.",
          "locationAlwaysPermission": "Nowhere also requires your location in the background to continue location simulation.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "./plugins/withBackgroundPermissions/app.plugin.js",
      "expo-status-bar"
    ],
    "ios": {
      "bundleIdentifier": "com.cactus-apps.nowhere",
      "buildNumber": "1"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ccea1e79-a8f5-4e53-bab1-80532e2b3c51"
      }
    },
    "owner": "nowhere127",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/ccea1e79-a8f5-4e53-bab1-80532e2b3c51"
    }
  }
}
