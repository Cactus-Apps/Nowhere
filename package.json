{
  "name": "Atalasys-Hide_Phantom",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');['react-native-webview','expo-asset'].forEach(mod=>{const d=p.join('node_modules/react-native-maplibre-gl-js/node_modules',mod);if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true});console.log('Removed nested '+mod)}});const dndPkg=p.join('node_modules/react-native-reanimated-dnd/package.json');if(fs.existsSync(dndPkg)){const pkg=JSON.parse(fs.readFileSync(dndPkg,'utf8'));if(pkg.exports){delete pkg.exports;fs.writeFileSync(dndPkg,JSON.stringify(pkg,null,2)+'\\n');console.log('Fixed react-native-reanimated-dnd exports')}}\""
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^0.546.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maplibre-gl-js": "^1.24.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "react-refresh": "^0.14.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-maplibre-gl-js": {
      "maplibre-gl": "6.4.1"
    }
  }
}
